{
    "ai": {
        "analysis_concurrency": 5,
        "api_key_env": "GOOGLE_API_KEY",
        "enrichment_concurrency": 5,
        "languages": [
            "zh"
        ],
        "max_tokens": 8192,
        "model": "gemini-2.0-flash",
        "provider": "gemini",
        "temperature": 0.3,
        "throttle_sec": 1
    },
    "collection": {
        "time_window_hours": 24
    },
    "digest": {
        "category_groups": {
            "ai": {
                "categories": [
                    "ai-news",
                    "ai-tools",
                    "machine-learning",
                    "llm-inference",
                    "semiconductors"
                ],
                "limit": 8
            },
            "finance": {
                "categories": [
                    "finance",
                    "equities",
                    "crypto"
                ],
                "limit": 8
            }
        },
        "default_group": "other",
        "default_group_limit": 4,
        "max_items": 20,
        "profile_order": [
            "finance-news",
            "tech-news",
            "tech-blog"
        ]
    },
    "processing": {
        "default_profile": "tech-news",
        "profile_settings": {
            "finance-news": {
                "threshold": 3.0,
                "topic_dedup": true
            },
            "tech-blog": {
                "threshold": 3.0,
                "topic_dedup": false
            },
            "tech-news": {
                "threshold": 3.0,
                "topic_dedup": true
            }
        },
        "profiles_dir": "profiles"
    },
    "sources": {
        "github": [
            {
                "enabled": true,
                "profile": "tech-news",
                "type": "user_events",
                "username": "karpathy"
            },
            {
                "enabled": true,
                "owner": "vllm-project",
                "profile": "tech-news",
                "repo": "vllm",
                "type": "repo_releases"
            }
        ],
        "hackernews": {
            "enabled": true,
            "fetch_top_stories": 30,
            "min_score": 150,
            "profile": "tech-news"
        },
        "reddit": {
            "enabled": true,
            "fetch_comments": 10,
            "subreddits": [
                {
                    "enabled": true,
                    "fetch_limit": 10,
                    "min_score": 60,
                    "profile": "tech-news",
                    "sort": "hot",
                    "subreddit": "MachineLearning",
                    "time_filter": "day"
                },
                {
                    "enabled": true,
                    "fetch_limit": 10,
                    "min_score": 60,
                    "profile": "tech-news",
                    "sort": "hot",
                    "subreddit": "LocalLLaMA",
                    "time_filter": "day"
                },
                {
                    "enabled": true,
                    "fetch_limit": 10,
                    "min_score": 60,
                    "profile": "finance-news",
                    "sort": "hot",
                    "subreddit": "stocks",
                    "time_filter": "day"
                },
                {
                    "enabled": true,
                    "fetch_limit": 10,
                    "min_score": 60,
                    "profile": "finance-news",
                    "sort": "hot",
                    "subreddit": "CryptoCurrency",
                    "time_filter": "day"
                }
            ],
            "users": []
        },
        "rss": [
            {
                "category": "ai-tools",
                "enabled": true,
                "name": "Simon Willison",
                "profile": "tech-news",
                "url": "https://simonwillison.net/atom/everything/"
            },
            {
                "category": "llm-inference",
                "content_extractor": "trafilatura",
                "enabled": true,
                "name": "vLLM Blog",
                "profile": "tech-blog",
                "url": "https://vllm.ai/blog/rss.xml"
            },
            {
                "category": "software-engineering",
                "content_extractor": "trafilatura",
                "enabled": true,
                "name": "Sean Goedecke",
                "profile": "tech-blog",
                "url": "https://www.seangoedecke.com/rss.xml"
            },
            {
                "category": "finance",
                "content_extractor": "trafilatura",
                "enabled": true,
                "name": "CNBC Finance",
                "profile": "finance-news",
                "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664"
            },
            {
                "category": "semiconductors",
                "enabled": true,
                "name": "Semianalysis",
                "profile": "tech-news",
                "url": "https://newsletter.semianalysis.com/feed"
            },
            {
                "category": "github-trending",
                "enabled": true,
                "name": "GitHub Trending - Daily",
                "profile": "tech-news",
                "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml"
            },
            {
                "category": "finance",
                "enabled": true,
                "name": "Google News - 美股",
                "profile": "finance-news",
                "url": "https://news.google.com/rss/search?q=%E7%BE%8E%E8%82%A1%20OR%20%E6%A0%87%E6%99%AE500%20OR%20%E7%BA%B3%E6%96%AF%E8%BE%BE%E5%85%8B&hl=zh-CN&gl=CN&ceid=CN:zh-Hans"
            },
            {
                "category": "finance",
                "enabled": true,
                "name": "Google News - 港股打新",
                "profile": "finance-news",
                "url": "https://news.google.com/rss/search?q=%E6%B8%AF%E8%82%A1%E6%89%93%E6%96%B0%20OR%20%E6%B8%AF%E8%82%A1IPO%20OR%20%E6%96%B0%E8%82%A1%E8%AE%A4%E8%B4%AD&hl=zh-CN&gl=CN&ceid=CN:zh-Hans"
            },
            {
                "category": "crypto",
                "enabled": true,
                "name": "Google News - 加密货币",
                "profile": "finance-news",
                "url": "https://news.google.com/rss/search?q=%E6%AF%94%E7%89%B9%E5%B8%81%20OR%20%E4%BB%A5%E5%A4%AA%E5%9D%8A%20OR%20%E5%8A%A0%E5%AF%86%E8%B4%A7%E5%B8%81&hl=zh-CN&gl=CN&ceid=CN:zh-Hans"
            },
            {
                "category": "ai-tools",
                "enabled": true,
                "name": "Google News - iPhone/苹果",
                "profile": "tech-news",
                "url": "https://news.google.com/rss/search?q=iPhone%20OR%20%E8%8B%B9%E6%9E%9C%E5%85%AC%E5%8F%B8%20OR%20Apple&hl=zh-CN&gl=CN&ceid=CN:zh-Hans"
            }
        ],
        "telegram": {
            "channels": [],
            "enabled": false
        }
    },
    "webhook": {
        "delivery": "summary",
        "enabled": false,
        "fallback_layout": "markdown",
        "headers": "",
        "languages": null,
        "layout": "markdown",
        "overview_position": "first",
        "platform": "generic",
        "request_body": {
            "card": {
                "body": {
                    "elements": [
                        {
                            "content": "Horizon生成结果: #{result}\nHorizon日报重要资讯数量: #{important_items}/#{all_items}",
                            "tag": "markdown"
                        },
                        {
                            "tag": "hr"
                        },
                        {
                            "content": "#{summary}",
                            "tag": "markdown"
                        }
                    ]
                },
                "config": {
                    "wide_screen_mode": true
                },
                "header": {
                    "template": "blue",
                    "title": {
                        "content": "#{message_title}",
                        "tag": "plain_text"
                    }
                },
                "schema": "2.0"
            },
            "msg_type": "interactive"
        },
        "url_env": "HORIZON_WEBHOOK_URL"
    },
    "wechat": {
        "chunk_size": 4000,
        "enabled": false,
        "languages": null
    }
}
